{
 "uid": "pdu-outlets",
 "title": "PDU — consommation par prise",
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "pdu",
    "label": "PDU",
    "type": "query",
    "datasource": {
     "type": "influxdb",
     "uid": "influxdb-pdu"
    },
    "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"pdu\", tag: \"pdu\")",
    "refresh": 2,
    "includeAll": false,
    "multi": false,
    "current": {}
   },
   {
    "name": "outlet",
    "label": "Prise",
    "type": "query",
    "datasource": {
     "type": "influxdb",
     "uid": "influxdb-pdu"
    },
    "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"pdu\", tag: \"outlet\", predicate: (r) => r.pdu == \"${pdu}\")",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Vue globale du PDU $pdu",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Puissance totale (W)",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-pdu"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "query": "from(bucket: \"pdu\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pdu_metrics\" and r.pdu == \"${pdu}\")\n  |> filter(fn: (r) => r._field == \"power\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Courant total (A)",
   "datasource": {
